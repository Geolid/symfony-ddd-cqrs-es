{
  "name": "showcase/symfony-ddd-cqrs-es",
  "description": "Showcase: DDD, CQRS and Event Sourcing architecture with Symfony",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.5",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "api-platform/core": "^5.0",
    "doctrine/doctrine-bundle": "^3.3.2",
    "dragonmantank/cron-expression": "^3.6",
    "endroid/qr-code": "^6.1.3",
    "itspire/monolog-loki": "^2.1.1",
    "matomo/device-detector": "^6.5",
    "nelmio/api-doc-bundle": "^5.12.2",
    "patchlevel/event-sourcing-bundle": "^3.17.1",
    "predis/predis": "^3.6.1",
    "ramsey/uuid": "^4.9.4",
    "scheb/2fa-bundle": "^8.6.1",
    "scheb/2fa-trusted-device": "^8.6.1",
    "sentry/sentry-symfony": "^5.13",
    "spomky-labs/otphp": "^11.5",
    "symfony/asset": "8.1.*",
    "symfony/asset-mapper": "8.1.*",
    "symfony/console": "8.1.*",
    "symfony/doctrine-messenger": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/expression-language": "8.1.*",
    "symfony/form": "8.1.*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/http-client": "8.1.*",
    "symfony/intl": "^8.1.5",
    "symfony/lock": "8.1.*",
    "symfony/mailer": "8.1.*",
    "symfony/messenger": "8.1.*",
    "symfony/monolog-bundle": "^4.1",
    "symfony/password-hasher": "8.1.*",
    "symfony/rate-limiter": "^8.1.6",
    "symfony/runtime": "8.1.*",
    "symfony/scheduler": "8.1.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/security-csrf": "8.1.*",
    "symfony/stimulus-bundle": "^3.5.1",
    "symfony/string": "^8.1.7",
    "symfony/translation": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/ux-icons": "^3.5.1",
    "symfony/ux-twig-component": "^3.5.1",
    "symfony/validator": "8.1.*",
    "symfony/webhook": "8.1.*",
    "symfony/yaml": "8.1.*",
    "webmozart/assert": "^2.4.1"
  },
  "require-dev": {
    "brianium/paratest": "^7.25",
    "captainhook/captainhook": "^5.29.2",
    "dama/doctrine-test-bundle": "^8.6",
    "deptrac/deptrac": "^4.7.2",
    "fakerphp/faker": "^1.24.1",
    "friendsofphp/php-cs-fixer": "^3.95.27",
    "infection/infection": "^0.35.4",
    "patchlevel/event-sourcing-dashboard-bundle": "^1.0",
    "patchlevel/event-sourcing-phpstan-extension": "^1.3",
    "patchlevel/event-sourcing-phpunit": "^1.7",
    "phpat/phpat": "^0.12.5",
    "phpstan/phpstan": "^2.2.15",
    "phpstan/phpstan-phpunit": "^2.0.18",
    "phpstan/phpstan-symfony": "^2.0.20",
    "phpunit/phpunit": "^13.3.4",
    "rector/rector": "^2.6.7",
    "symfony/browser-kit": "8.1.*",
    "symfony/css-selector": "8.1.*",
    "symfony/debug-bundle": "8.1.*",
    "symfony/phpunit-bridge": "8.1.*",
    "symfony/stopwatch": "8.1.*",
    "symfony/web-profiler-bundle": "8.1.*",
    "vincentlanglet/twig-cs-fixer": "^4.1.1"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true,
      "php-http/discovery": true,
      "symfony/flex": false,
      "symfony/runtime": true
    },
    "bump-after-update": true,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Bootstrap\\": "bootstrap/",
      "Catalog\\": "src/Catalog/",
      "Compliance\\": "src/Compliance/",
      "Crm\\": "src/Crm/",
      "Cron\\": "apps/cron/src/",
      "Finance\\": "src/Finance/",
      "Fulfilment\\": "src/Fulfilment/",
      "Iam\\": "src/Iam/",
      "Sales\\": "src/Sales/",
      "Shared\\": "src/Shared/",
      "Shopping\\": "src/Shopping/",
      "Storefront\\": "apps/storefront/src/",
      "Ui\\": "ui/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Catalog\\Tests\\": "tests/Catalog/",
      "Compliance\\Tests\\": "tests/Compliance/",
      "Crm\\Tests\\": "tests/Crm/",
      "Cron\\Tests\\": "apps/cron/tests/",
      "Finance\\Tests\\": "tests/Finance/",
      "Fulfilment\\Tests\\": "tests/Fulfilment/",
      "Iam\\Tests\\": "tests/Iam/",
      "Sales\\Tests\\": "tests/Sales/",
      "Shopping\\Tests\\": "tests/Shopping/",
      "Shared\\Tests\\": "tests/Shared/",
      "Storefront\\Tests\\": "apps/storefront/tests/",
      "Support\\": "tests/Support/",
      "Demo\\": "demo/",
      "Tools\\": "tools/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*"
  },
  "conflict": {
    "symfony/symfony": "*"
  }
}
