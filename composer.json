{
  "name": "showcase/symfony-ddd-cqrs-es",
  "description": "Showcase: DDD, CQRS and Event Sourcing architecture with Symfony",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.5",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "api-platform/core": "^4.3",
    "doctrine/doctrine-bundle": "^3.2",
    "dragonmantank/cron-expression": "^3.6",
    "itspire/monolog-loki": "^2.1",
    "nelmio/api-doc-bundle": "^5.10",
    "patchlevel/event-sourcing-bundle": "^3.17",
    "ramsey/uuid": "^4.9",
    "sentry/sentry-symfony": "^5.10",
    "symfony/asset": "8.1.*",
    "symfony/asset-mapper": "8.1.*",
    "symfony/console": "8.1.*",
    "symfony/doctrine-messenger": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/expression-language": "8.1.*",
    "symfony/form": "8.1.*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/http-client": "8.1.*",
    "symfony/lock": "8.1.*",
    "symfony/mailer": "8.1.*",
    "symfony/messenger": "8.1.*",
    "symfony/monolog-bundle": "^4.0",
    "symfony/runtime": "8.1.*",
    "symfony/scheduler": "8.1.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/security-csrf": "8.1.*",
    "symfony/stimulus-bundle": "^3.4",
    "symfony/translation": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/ux-icons": "^3.4",
    "symfony/ux-twig-component": "^3.4",
    "symfony/validator": "8.1.*",
    "symfony/webhook": "8.1.*",
    "symfony/yaml": "8.1.*",
    "webmozart/assert": "^2.4"
  },
  "require-dev": {
    "brianium/paratest": "^7.23",
    "captainhook/captainhook": "^5.29",
    "dama/doctrine-test-bundle": "^8.2",
    "deptrac/deptrac": "^4.6",
    "fakerphp/faker": "^1.24.1",
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.34",
    "patchlevel/event-sourcing-admin-bundle": "@dev",
    "patchlevel/event-sourcing-phpunit": "^1.7",
    "phpat/phpat": "^0.12",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^13.2",
    "symfony/browser-kit": "8.1.*",
    "symfony/css-selector": "8.1.*",
    "symfony/debug-bundle": "8.1.*",
    "symfony/phpunit-bridge": "8.1.*",
    "symfony/stopwatch": "8.1.*",
    "symfony/web-profiler-bundle": "8.1.*",
    "vincentlanglet/twig-cs-fixer": "^4.0"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true,
      "php-http/discovery": true,
      "symfony/flex": false,
      "symfony/runtime": true
    },
    "bump-after-update": true,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Bootstrap\\": "bootstrap/",
      "Api\\": "apps/api/src/",
      "Cli\\": "apps/cli/src/",
      "Web\\": "apps/web/src/",
      "Webhook\\": "apps/webhook/src/",
      "Catalog\\": "src/Catalog/",
      "Fulfilment\\": "src/Fulfilment/",
      "Iam\\": "src/Iam/",
      "Sales\\": "src/Sales/",
      "Shared\\": "src/Shared/",
      "Ui\\": "ui/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Api\\Tests\\": "apps/api/tests/",
      "Cli\\Tests\\": "apps/cli/tests/",
      "Web\\Tests\\": "apps/web/tests/",
      "Webhook\\Tests\\": "apps/webhook/tests/",
      "Catalog\\Tests\\": "tests/Catalog/",
      "Fulfilment\\Tests\\": "tests/Fulfilment/",
      "Iam\\Tests\\": "tests/Iam/",
      "Sales\\Tests\\": "tests/Sales/",
      "Shared\\Tests\\": "tests/Shared/",
      "Support\\": "tests/Support/",
      "Demo\\": "demo/",
      "Tools\\": "tools/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*"
  },
  "scripts": {
    "post-install-cmd": [
      "make assets warmup"
    ],
    "post-update-cmd": [
      "make assets warmup"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  }
}
