{
  "name": "showcase/symfony-ddd-cqrs-es",
  "description": "Showcase: DDD, CQRS and Event Sourcing architecture with Symfony",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/doctrine-bundle": "^3.2",
    "patchlevel/event-sourcing-bundle": "^3.17",
    "ramsey/uuid": "^4.9",
    "sentry/sentry-symfony": "^5.10",
    "symfony/console": "8.1.*",
    "symfony/doctrine-messenger": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/http-client": "8.1.*",
    "symfony/messenger": "8.1.*",
    "symfony/monolog-bundle": "^4.0",
    "symfony/runtime": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/yaml": "8.1.*",
    "webmozart/assert": "^1.11"
  },
  "require-dev": {
    "dama/doctrine-test-bundle": "^8.2",
    "deptrac/deptrac": "^4.6",
    "friendsofphp/php-cs-fixer": "^3.95",
    "patchlevel/event-sourcing-phpunit": "^1.7",
    "phpat/phpat": "^0.12",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "8.1.*",
    "symfony/css-selector": "8.1.*",
    "symfony/phpunit-bridge": "8.1.*",
    "symfony/stopwatch": "8.1.*"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Bootstrap\\": "bootstrap/",
      "Web\\": "apps/web/src/",
      "Api\\": "apps/api/src/",
      "Cli\\": "apps/cli/src/",
      "Webhook\\": "apps/webhook/src/",
      "Ordering\\": "src/Ordering/",
      "Shipping\\": "src/Shipping/",
      "Shared\\": "src/Shared/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Web\\Tests\\": "apps/web/tests/",
      "Api\\Tests\\": "apps/api/tests/",
      "Cli\\Tests\\": "apps/cli/tests/",
      "Webhook\\Tests\\": "apps/webhook/tests/",
      "Ordering\\Tests\\": "tests/Ordering/",
      "Shipping\\Tests\\": "tests/Shipping/",
      "Shared\\Tests\\": "tests/Shared/",
      "Support\\": "tests/Support/",
      "Demo\\": "demo/",
      "Tools\\PHPat\\": "tools/PHPat/",
      "Tools\\PhpStan\\": "tools/PHPStan/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*"
  },
  "conflict": {
    "symfony/symfony": "*"
  }
}
