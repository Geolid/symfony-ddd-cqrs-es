RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^checkout/sessions/([A-Za-z0-9\-]+)/capture$ capture.php?reference=$1 [L,QSA]
RewriteRule ^checkout/sessions/([A-Za-z0-9\-]+)/cancel$ cancel.php?reference=$1 [L,QSA]
RewriteRule ^checkout/sessions/([A-Za-z0-9\-]+)/refund$ refund.php?reference=$1 [L,QSA]
RewriteRule ^checkout/sessions/([A-Za-z0-9\-]+)$ sessions.php?reference=$1 [L,QSA]
RewriteRule ^checkout/sessions$ sessions.php [L]
