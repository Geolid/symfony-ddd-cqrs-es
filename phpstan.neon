includes:
    - phpstan.base.neon

parameters:
    tmpDir: var/phpstan/src

    paths:
        - bin/
        - bootstrap/
        - config/
        - demo/
        - public/
        - src/
        - tools/
        - ui/
        - castor.php
        - .castor/

    # Deliberately-invalid fixtures for custom rule tests — tools/ is analysed too, so
    # without this exclusion a rule (global via services tag) would flag its own fixture
    # for real, on top of the isolated RuleTestCase run.
    excludePaths:
        - tools/PHPStan/Tests/data/*

    # Castor is a standalone binary, not a Composer dependency.
    # This generated stub provides all IDE type-hinting for castor.php and .castor/.
    scanFiles:
        - .castor/.castor.stub.php

    symfony:
        containerXmlPath: var/cache/%env.APP_ENV%/Bootstrap_Kernel%env.APP_ENV_UCFIRST%DebugContainer.xml
