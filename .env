# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.

# =============================================================================
# SYMFONY CORE
# =============================================================================
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# =============================================================================
# DATABASES (MariaDB, see compose.yaml)
# =============================================================================
EVENT_STORE_URL=mysql://root@db:3306/event_store?serverVersion=mariadb-11.8.0&charset=utf8mb4
READ_MODEL_URL=mysql://root@db:3306/read_model?serverVersion=mariadb-11.8.0&charset=utf8mb4
MESSENGER_URL=mysql://root@db:3306/messenger?serverVersion=mariadb-11.8.0&charset=utf8mb4

# =============================================================================
# MESSENGER & LOCK
# =============================================================================
MESSENGER_TRANSPORT_DSN=sync://
MESSENGER_FAILURE_DSN=doctrine://messenger?queue_name=failed

# Shared locks between servers via flock:// (Requires shared volume).
# Consider Valkey or PDO for a more robust distributed lock in prod.
LOCK_DSN=flock://%kernel.share_dir%/locks

# =============================================================================
# MAIL
# =============================================================================
MAILER_DSN=smtp://mailer:1025

# =============================================================================
# MONITORING (Sentry/GlitchTip, Loki — empty disables reporting)
# =============================================================================
# Point at a self-hosted Sentry or GlitchTip instance (same wire protocol).
# Empty = error tracking disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Point at a self-hosted or free-tier Loki instance to ship prod logs there.
# Empty = loki_safe handler no-ops.
LOKI_URL=
LOKI_BASIC_AUTH_USER=
LOKI_BASIC_AUTH_PASSWORD=

# =============================================================================
# WEBHOOKS & SECURITY
# =============================================================================
CARRIER_WEBHOOK_SECRET=change-me
PAYMENT_WEBHOOK_SECRET=change-me

# apps/es-admin
# Must be a base64-encoded hash to prevent breaking NGINX redirects.
#
# Generation:
# 1. Run `bin/console --appId=es-admin security:hash-password`
# 2. Copy the resulting hash and base64-encode it (e.g., `echo -n 'HASH' | base64`)
ES_ADMIN_PASSWORD_HASH=change-me

# =============================================================================
# EXTERNAL APIs
# =============================================================================
ACME_BASE_URL=http://acme-api
ACME_API_TOKEN=change-me

GLOBEX_BASE_URL=http://globex-api
GLOBEX_API_TOKEN=change-me

# =============================================================================
# FULFILMENT — return address (where the carrier delivers a customer return)
# =============================================================================
FULFILMENT_RETURN_ADDRESS_NAME="Returns Department"
FULFILMENT_RETURN_ADDRESS_STREET="1 rue de l'Entrepot"
FULFILMENT_RETURN_ADDRESS_POSTAL_CODE=75012
FULFILMENT_RETURN_ADDRESS_CITY=Paris
