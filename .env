# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me
APP_SHARE_DIR=var/share

## Databases (open-source MariaDB, see compose.yaml — no managed/paid database service)
LOCK_DSN=flock

## Messenger transports — Doctrine-backed by default (zero extra infra). Swap for
## redis://redis:6379/messages or amqp://guest:guest@rabbitmq:5672/%2f/messages (both free,
## self-hostable) if you outgrow a single database as the queue.
MESSENGER_TRANSPORT_DSN=doctrine://messenger?queue_name=async
MESSENGER_FAILURE_DSN=doctrine://messenger?queue_name=failed

## Error tracking — point this at a self-hosted Sentry instance or GlitchTip (a free,
## open-source, Sentry-protocol-compatible alternative). Empty/unset disables reporting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

## Inbound carrier webhook — shared secret used to verify the HMAC signature (see
## apps/webhook). Generate a real one for anything beyond local dev.
CARRIER_WEBHOOK_SECRET=change-me-in-env-local

DEFAULT_URI=http://localhost
MAILER_DSN=smtp://mailer:1025

# Root, empty password — matches compose.yaml MARIADB_ALLOW_EMPTY_ROOT_PASSWORD (no
# restricted app user / init.sql grants needed; SetupDatabaseExtension and make db
# both rely on the DB user being able to CREATE DATABASE on its own).
EVENT_STORE_URL=mysql://root@db:3306/event_store?serverVersion=mariadb-11.8.0&charset=utf8mb4
READ_MODEL_URL=mysql://root@db:3306/read_model?serverVersion=mariadb-11.8.0&charset=utf8mb4
MESSENGER_URL=mysql://root@db:3306/messenger?serverVersion=mariadb-11.8.0&charset=utf8mb4

# Optional: point at a free-tier Grafana Cloud Loki instance (or any self-hosted Loki) to
# ship prod logs there — see README "Open source over paid SaaS". Empty = the loki_safe
# handler silently no-ops (whatfailuregroup swallows the push failure).
LOKI_URL=
LOKI_BASIC_AUTH_USER=
LOKI_BASIC_AUTH_PASSWORD=

ACME_BASE_URL=https://carrier.acme.test
ACME_API_TOKEN=change-me

GLOBEX_BASE_URL=https://payments.globex.test
GLOBEX_API_TOKEN=change-me
PAYMENT_WEBHOOK_SECRET=change-me-too
