{% props flashes %}

{% if flashes %}
    <div class="flash-container">
        {% for label, messages in flashes %}
            {% for message in messages %}
                <twig:ui:Toast
                    :variant="label"
                    data-controller="flash"
                    data-action="click->flash#dismiss">
                    {{ message }}
                </twig:ui:Toast>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}
