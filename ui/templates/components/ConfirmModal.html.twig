{% set c = this %}
<twig:ui:Modal>
    {% block trigger %}
        <button type="button" class="confirm-modal__trigger {{ c.triggerClass }}" data-action="modal#open" {{ c.disabled ? 'disabled' : '' }}>
            {{ c.triggerLabel }}
        </button>
    {% endblock %}
    <h2>{{ c.title }}</h2>
    <p>{{ c.message }}</p>
    <footer>
        <button class="secondary" data-action="modal#close">{{ c.cancelLabel }}</button>
        <twig:ui:CsrfButton :actionUrl="c.actionUrl" :csrfId="c.id" :label="c.confirmLabel" :disabled="c.disabled" class="{{ c.confirmClass }}" />
    </footer>
</twig:ui:Modal>
