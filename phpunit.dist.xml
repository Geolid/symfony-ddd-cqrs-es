<?xml version="1.0" encoding="UTF-8"?>

<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="var/.phpunit.cache"
         executionOrder="depends,defects"
         beStrictAboutOutputDuringTests="true"
>
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="KERNEL_CLASS" value="Bootstrap\Kernel"/>
        <server name="SHELL_VERBOSITY" value="-1"/>
    </php>

    <testsuites>
        <!-- DELIVERY MECHANISMS -->
        <testsuite name="api">
            <directory>apps/api/tests</directory>
        </testsuite>
        <testsuite name="cli">
            <directory>apps/cli/tests</directory>
        </testsuite>
        <testsuite name="web">
            <directory>apps/web/tests</directory>
        </testsuite>
        <testsuite name="webhook">
            <directory>apps/webhook/tests</directory>
        </testsuite>

        <!-- SUBDOMAINS -->
        <testsuite name="catalog">
            <directory>tests/Catalog</directory>
        </testsuite>
        <testsuite name="fulfilment">
            <directory>tests/Fulfilment</directory>
        </testsuite>
        <testsuite name="iam">
            <directory>tests/Iam</directory>
        </testsuite>
        <testsuite name="sales">
            <directory>tests/Sales</directory>
        </testsuite>

        <!-- SHARED -->
        <testsuite name="shared">
            <directory>tests/Shared</directory>
        </testsuite>

        <!-- TOOLS -->
        <testsuite name="tools">
            <directory>tools/PHPStan/Tests</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>apps/*/src</directory>
            <directory>src</directory>
        </include>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <coverage>
        <report>
            <html outputDirectory="var/coverage/html"/>
            <clover outputFile="var/coverage/clover.xml"/>
            <cobertura outputFile="var/coverage/cobertura.xml"/>
            <xml outputDirectory="var/coverage/coverage-xml"/>
            <text outputFile="php://stdout" showOnlySummary="true" />
        </report>
    </coverage>

    <logging>
        <junit outputFile="var/coverage/junit.xml"/>
    </logging>

    <extensions>
        <bootstrap class="Tools\PHPUnit\EventSourcingExtension"/>
        <bootstrap class="Tools\PHPUnit\ClockExtension"/>
        <bootstrap class="Tools\PHPUnit\FakerSeedExtension"/>
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
        <bootstrap class="Symfony\Bridge\PhpUnit\SymfonyExtension"/>
    </extensions>
</phpunit>
