{
    "config": {
        "run": {
            "mode": "docker",
            "exec": "docker compose exec app"
        }
    },
    "commit-msg": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Regex",
                "options": {
                    "regex": "/\\A(build|chore|ci|docs|feat|fix|perf|refactor|revert|simplify|style|test)(\\([\\w.\\/-]+\\))?!?: \\S.+/",
                    "error": "Commit subject must follow Conventional Commits: <type>(<scope>)?: <description>\nAllowed types: build, chore, ci, docs, feat, fix, perf, refactor, revert, simplify, style, test",
                    "success": "Conventional Commits format OK"
                }
            }
        ]
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\PHP\\Action\\Linting",
                "config": {
                    "label": "Lint staged PHP files"
                }
            },
            {
                "action": "\\CaptainHook\\App\\Hook\\Branch\\Action\\EnsureNaming",
                "options": {
                    "regex": "#^(feature|feat|bugfix|fix|hotfix|release|chore|ai|claude|codex|copilot|cursor)/[a-z0-9]+(\\.[a-z0-9]+)*(-[a-z0-9]+(\\.[a-z0-9]+)*)*$#",
                    "error": "Branch name must follow Conventional Branch: <type>/<description>\nAllowed types: feature, feat, bugfix, fix, hotfix, release, chore, ai, claude, codex, copilot, cursor",
                    "success": "Conventional Branch format OK"
                }
            }
        ]
    },
    "pre-push": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\Branch\\Action\\EnsureNaming",
                "options": {
                    "regex": "#^(feature|feat|bugfix|fix|hotfix|release|chore|ai|claude|codex|copilot|cursor)/[a-z0-9]+(\\.[a-z0-9]+)*(-[a-z0-9]+(\\.[a-z0-9]+)*)*$#",
                    "error": "Branch name must follow Conventional Branch: <type>/<description>\nAllowed types: feature, feat, bugfix, fix, hotfix, release, chore, ai, claude, codex, copilot, cursor",
                    "success": "Conventional Branch format OK"
                }
            }
        ]
    }
}
