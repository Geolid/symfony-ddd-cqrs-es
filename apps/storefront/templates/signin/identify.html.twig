{% extends 'layout_auth.html.twig' %}
{% trans_default_domain 'signin' %}

{% block title %}{{ 'identify_title'|trans }}{% endblock %}

{% block content %}
    <article class="auth-card">
        <h1>{{ 'identify_title'|trans }}</h1>

        {{ form_start(form) }}
            {{ form_row(form.email) }}
            <button type="submit">{{ 'identify_button_submit'|trans }}</button>
        {{ form_end(form) }}
    </article>
{% endblock %}
