{% extends 'layout.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <h1>Connexion</h1>

    <form method="get" action="{{ path('security_login') }}" data-testid="identify-form">
        <label for="identify-email">Email</label>
        <input type="email" id="identify-email" name="email" data-testid="identify-email" required autofocus>

        <button type="submit" data-testid="identify-submit">Continuer</button>
    </form>
{% endblock %}
