{% extends 'account/security/_layout.html.twig' %}
{% trans_default_domain 'account_security' %}
{% import 'account/security/_breadcrumb.html.twig' as security %}

{% block title %}{{ 'change_password_title'|trans }}{% endblock %}

{% block content %}
    {{ security.trail([
        {label: 'change_password_title'|trans},
    ]) }}

    <h1>{{ 'change_password_title'|trans }}</h1>

    {{ form_start(form, {attr: {'data-testid': 'change-password-form'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.currentPassword) }}
        {{ form_errors(form.newPassword) }}
        {{ form_row(form.newPassword.first) }}
        {{ form_row(form.newPassword.second) }}
        <button type="submit" data-testid="change-password-submit">{{ 'change_password_button_submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
