{% extends 'account/_layout.html.twig' %}
{% trans_default_domain 'account_security' %}
{% import 'account/security/_breadcrumb.html.twig' as security %}

{% block title %}{{ 'trusted_devices_title'|trans }}{% endblock %}

{% block content %}
    {{ security.trail([
        {label: 'two_factor_settings_title'|trans, url: path('storefront_account_security_two_factor_settings')},
        {label: 'trusted_devices_title'|trans},
    ]) }}

    <h1>{{ 'trusted_devices_title'|trans }}</h1>

    <p>{{ 'trusted_devices_instructions'|trans({'%days%': trusted_device_expiry_days()}) }}</p>

    {% if trustedDevices is empty %}
        <p>{{ 'trusted_devices_empty'|trans }}</p>
    {% else %}
        <div class="trusted-devices" data-testid="trusted-devices">
            {% for trustedDevice in trustedDevices %}
                {% set agent = device_agent(trustedDevice.userAgent) %}
                <article class="trusted-device-card" data-testid="trusted-device">
                    <div>
                        <twig:ux:icon name="{{ agent.icon }}" class="icon" />
                        <div>
                            <strong>{{ agent.label }}</strong> &mdash; IP: {{ trustedDevice.ip }}
                            <br>
                            <small>{{ trustedDevice.trustedAt|date('d/m/Y H:i') }}</small>
                        </div>
                    </div>
                    <twig:ui:ActionForm
                        actionUrl="{{ path('storefront_account_security_revoke_trusted_device', {id: trustedDevice.id}) }}"
                        csrfId="revoke_trusted_device_{{ trustedDevice.id }}"
                        label="{{ 'trusted_devices_button_revoke'|trans }}"
                        formTestId="revoke-trusted-device-form"
                        class="outline pico-background-red-500"
                        data-testid="revoke-trusted-device-submit"
                    />
                </article>
            {% endfor %}
        </div>

        <hr>

        <article class="settings-sections">
            <div>
                <p class="icon-text"><twig:ux:icon name="warning" class="icon icon-warning" /> {{ 'trusted_devices_section_revoke_all_instructions'|trans }}</p>
            </div>
            <twig:ui:ActionForm
                actionUrl="{{ path('storefront_account_security_revoke_trusted_devices') }}"
                csrfId="revoke_trusted_devices"
                label="{{ 'trusted_devices_button_revoke_all'|trans }}"
                formTestId="revoke-trusted-devices-form"
                class="outline pico-background-red-500"
                data-testid="revoke-trusted-devices-submit"
            />
        </article>
    {% endif %}

    <p><a href="{{ path('storefront_account_security_two_factor_settings') }}">&larr; {{ 'backup_codes_link_back'|trans }}</a></p>
{% endblock %}
