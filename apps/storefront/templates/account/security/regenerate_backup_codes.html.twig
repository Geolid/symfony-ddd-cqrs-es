{% extends 'layout.html.twig' %}
{% trans_default_domain 'account_security' %}

{% block javascripts %}
    {% block importmap %}{{ importmap(['shared', 'account']) }}{% endblock %}
{% endblock %}

{% block title %}{{ 'regenerate_recovery_codes_title'|trans }}{% endblock %}

{% block content %}
    <twig:ui:Breadcrumb :items="[
        {label: 'title'|trans({}, 'account'), url: path('storefront_account_show')},
        {label: 'show_title'|trans, url: path('storefront_account_security_show')},
        {label: 'two_step_settings_title'|trans, url: path('storefront_account_security_two_step_settings')},
        {label: 'two_step_settings_section_recovery_codes_title'|trans},
    ]" />

    <h1>{{ 'regenerate_recovery_codes_title'|trans }}</h1>

    <article>
        <p>{{ 'regenerate_recovery_codes_instructions'|trans }}</p>

        {{ include('account/security/_recovery_codes.html.twig', {backupCodes: backupCodes}) }}

        <p><a href="{{ path('storefront_account_security_two_step_settings') }}">&larr; {{ 'recovery_codes_link_back'|trans }}</a></p>
    </article>
{% endblock %}
