{% extends 'layout.html.twig' %}
{% trans_default_domain 'account_security' %}

{% block importmap %}{{ importmap(['shared', 'auth']) }}{% endblock %}

{% block title %}{{ 'enroll_two_factor_title'|trans }}{% endblock %}

{% block content %}
    <article>
        <h1>{{ 'enroll_two_factor_title'|trans }}</h1>

        <p>{{ 'enroll_two_factor_instructions_qr'|trans }}</p>
        <img src="{{ qrCodeDataUri }}" alt="{{ 'enroll_two_factor_title'|trans }}">

        <p>{{ 'enroll_two_factor_instructions_manual'|trans }}</p>
        <p>{{ secret }}</p>

        <p>{{ 'enroll_two_factor_instructions_confirm'|trans }}</p>

        {{ form_start(form) }}
            {{ form_row(form.code) }}
            <button type="submit">{{ 'enroll_two_factor_button_submit'|trans }}</button>
        {{ form_end(form) }}
    </article>
{% endblock %}
