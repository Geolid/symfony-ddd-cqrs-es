{% extends 'layout.html.twig' %}
{% trans_default_domain 'account_security' %}

{% block title %}{{ 'issue_totp_backup_codes_title'|trans }}{% endblock %}

{% block content %}
    <nav aria-label="breadcrumb">
        <ul>
            <li><a href="{{ path('storefront_account_show') }}">{{ 'title'|trans({}, 'account') }}</a></li>
            <li><a href="{{ path('storefront_account_security_show') }}">{{ 'show_title'|trans }}</a></li>
            <li>{{ 'issue_totp_backup_codes_title'|trans }}</li>
        </ul>
    </nav>

    <small>{{ 'issue_totp_backup_codes_step_indicator'|trans }}</small>
    <h1>{{ 'issue_totp_backup_codes_title'|trans }}</h1>

    <article>
        <p>{{ 'issue_totp_backup_codes_instructions'|trans }}</p>

        <ul>
            {% for backupCode in backupCodes %}
                <li>{{ backupCode }}</li>
            {% endfor %}
        </ul>

        <a href="{{ path('storefront_account_show') }}" role="button">
            {{ 'issue_totp_backup_codes_button_continue'|trans }}
        </a>
    </article>
{% endblock %}
