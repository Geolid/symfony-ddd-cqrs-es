{% extends 'layout.html.twig' %}

{% block title %}Mon compte{% endblock %}

{% block body %}
    <h1>Mon compte</h1>

    <p data-testid="account-identity-id">{{ user.identityId }}</p>

    {% if totpEnrolled %}
        <p data-testid="account-totp-status">Authentification à deux facteurs activée.</p>
    {% else %}
        <p><a href="{{ path('storefront_totp_enroll') }}" data-testid="nav-totp-enroll">Activer l'authentification à deux facteurs</a></p>
    {% endif %}

    <p><a href="{{ logout_path() }}" data-testid="nav-logout">Se déconnecter</a></p>
{% endblock %}
