{% extends 'account/_layout.html.twig' %}
{% trans_default_domain 'account_personal_data' %}

{% block title %}{{ 'show_title'|trans }}{% endblock %}

{% block content %}
    <twig:ui:Breadcrumb :items="[
        {label: 'title'|trans({}, 'account'), url: path('storefront_account_show')},
        {label: 'show_title'|trans},
    ]" />

    <h1 data-testid="personal-data-title">{{ 'show_title'|trans }}</h1>

    <article class="settings-sections">
        <dl>
            <dt>{{ 'show_label_erasure'|trans }}</dt>
            {% if erasure is null %}
                <dd>{{ 'show_erasure_description'|trans({'%duration%': erasure_retention()|duration}) }}</dd>
            {% else %}
                <dd data-testid="erasure-pending">{{ 'show_erasure_pending'|trans({'%requestedAt%': erasure.requestedAt|date('d/m/Y'), '%effectiveAt%': erasure.effectiveAt|date('d/m/Y')}) }}</dd>
            {% endif %}
        </dl>
        {% if erasure is null %}
            <a href="{{ path('storefront_account_personal_data_confirm_erasure') }}" role="button" class="outline pico-background-red-500" data-testid="request-erasure-link">{{ 'show_button_request_erasure'|trans }}</a>
        {% else %}
            <twig:ui:ActionForm
                actionUrl="{{ path('storefront_account_personal_data_cancel_erasure', {id: erasure.id}) }}"
                csrfId="cancel_erasure_{{ erasure.id }}"
                label="{{ 'show_button_cancel_erasure'|trans }}"
                formTestId="cancel-erasure-form"
                class="outline"
                data-testid="cancel-erasure-submit"
            />
        {% endif %}
    </article>
{% endblock %}
