<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>{% block title %}Storefront{% endblock %}</title>
</head>
<body>
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <p data-testid="flash-{{ label }}">{{ message }}</p>
    {% endfor %}
{% endfor %}
{% block body %}{% endblock %}
</body>
</html>
