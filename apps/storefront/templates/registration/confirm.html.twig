{% extends 'layout.html.twig' %}

{% block importmap %}{{ importmap(['shared', 'auth']) }}{% endblock %}

{% block title %}{{ 'title'|trans({}, 'confirm') }}{% endblock %}

{% block content %}
    <article>
        <h1>{{ 'title'|trans({}, 'confirm') }}</h1>

        <p>{{ 'message_sent'|trans({'%email%': email}, 'confirm') }} (<a href="{{ path('storefront_signin', {email: email}) }}">{{ 'link_modify'|trans }}</a>)</p>

        {{ form_start(form) }}
            {{ form_row(form.code) }}
            <button type="submit">{{ 'button_submit'|trans({}, 'confirm') }}</button>
        {{ form_end(form) }}

        <twig:ui:SubmitLink
            actionUrl="{{ path('storefront_register_confirm_resend', {id: id, email: email}) }}"
            csrfId="confirmation_resend"
            label="{{ 'button_resend'|trans }}"
        />
    </article>
{% endblock %}
