{% embed 'two_factor/_challenge_form.html.twig' %}
    {% block code_field %}
        <label for="two-factor-code">{{ 'label_backup_code'|trans({}, 'two_factor_challenge') }}</label>
        <input
            type="text"
            id="two-factor-code"
            name="{{ authCodeParameterName }}"
            autocomplete="one-time-code"
            inputmode="numeric"
            pattern="{{ pattern }}"
            required
            autofocus
        >
    {% endblock %}
{% endembed %}
