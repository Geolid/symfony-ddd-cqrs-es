{% extends 'layout.html.twig' %}

{% block importmap %}{{ importmap(['shared', 'auth']) }}{% endblock %}

{% block title %}{{ 'title'|trans({}, 'two_factor_challenge') }}{% endblock %}

{% block content %}
    <article>
        <h1>{{ 'title'|trans({}, 'two_factor_challenge') }}</h1>

        <form method="post" action="{{ checkPathUrl ?? path(checkPathRoute) }}">
            {% if authenticationError %}
                <div class="form-error">{{- authenticationError|trans(authenticationErrorData, 'security') -}}</div>
            {% endif %}

            <label for="two-factor-code">{{ 'label_code'|trans({}, 'two_factor_challenge') }}</label>
            <small>{{ 'hint_backup_code'|trans({}, 'two_factor_challenge') }}</small>
            <input
                type="text"
                id="two-factor-code"
                name="{{ authCodeParameterName }}"
                autocomplete="one-time-code"
                inputmode="numeric"
                pattern="{{ two_factor_code_pattern }}"
                required
                autofocus
            >

            {% if isCsrfProtectionEnabled %}
                <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
            {% endif %}

            <button type="submit">{{ 'button_submit'|trans({}, 'two_factor_challenge') }}</button>
        </form>

        <p><a href="{{ logoutPath }}">{{ 'link_logout'|trans({}, 'two_factor_challenge') }}</a></p>
    </article>
{% endblock %}
