{% extends 'layout.html.twig' %}

{% block importmap %}{{ importmap(['shared', 'auth']) }}{% endblock %}

{% block title %}{{ 'title'|trans({}, 'two_factor_enroll') }}{% endblock %}

{% block content %}
    <article>
        <h1>{{ 'title'|trans({}, 'two_factor_enroll') }}</h1>

        <p>{{ 'instructions_qr'|trans({}, 'two_factor_enroll') }}</p>
        <img src="{{ qrCodeDataUri }}" alt="{{ 'title'|trans({}, 'two_factor_enroll') }}">

        <p>{{ 'instructions_manual'|trans({}, 'two_factor_enroll') }}</p>
        <p>{{ secret }}</p>

        <p>{{ 'instructions_confirm'|trans({}, 'two_factor_enroll') }}</p>

        {{ form_start(form) }}
            {{ form_row(form.code) }}
            <button type="submit">{{ 'button_submit'|trans({}, 'two_factor_enroll') }}</button>
        {{ form_end(form) }}
    </article>
{% endblock %}
