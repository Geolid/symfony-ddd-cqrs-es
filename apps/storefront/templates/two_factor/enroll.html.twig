{% extends 'layout.html.twig' %}

{% block title %}Activer la double authentification{% endblock %}

{% block body %}
    <h1>Activer la double authentification</h1>

    <p>Scannez ce QR code avec votre application d'authentification (Google Authenticator, etc.) :</p>
    <img src="{{ qrCodeDataUri }}" alt="QR code d'activation de la double authentification" data-testid="two-factor-qr-code">

    <p>Ou saisissez ce code manuellement :</p>
    <p data-testid="two-factor-provisioning-uri">{{ provisioningUri }}</p>

    <p>Puis saisissez le code affiché pour confirmer :</p>

    {{ form_start(form, {attr: {'data-testid': 'two-factor-confirm-form'}}) }}
        {{ form_row(form.code) }}
        <button type="submit" data-testid="two-factor-confirm-submit">Confirmer</button>
    {{ form_end(form) }}
{% endblock %}
