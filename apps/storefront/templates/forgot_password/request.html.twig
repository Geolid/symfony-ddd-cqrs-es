{% extends 'layout_auth.html.twig' %}
{% trans_default_domain 'forgot_password' %}

{% block title %}{{ 'request_title'|trans }}{% endblock %}

{% block content %}
    <p>{{ 'request_subtitle'|trans }}</p>

    {{ form_start(form, {attr: {'data-testid': 'forgot-password-request-form'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.email) }}
        <button type="submit" data-testid="forgot-password-request-submit">{{ 'request_button_submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
