{% extends 'layout.html.twig' %}

{% block importmap %}{{ importmap(['shared', 'auth']) }}{% endblock %}

{% block title %}{{ 'title'|trans({}, 'password_reset') }}{% endblock %}

{% block content %}
    <article>
        <h1>{{ 'title'|trans({}, 'password_reset') }}</h1>

        <p>{{ 'subtitle'|trans({}, 'password_reset') }}</p>

        {{ form_start(form) }}
            {{ form_row(form.code) }}
            {{ form_row(form.newPassword.first) }}
            {{ form_row(form.newPassword.second) }}
            <button type="submit">{{ 'button_submit'|trans({}, 'password_reset') }}</button>
        {{ form_end(form) }}

        <twig:ui:SubmitLink
            actionUrl="{{ path('storefront_password_reset_resend', {identityId: identityId}) }}"
            csrfId="password_reset_resend"
            label="{{ 'button_resend'|trans }}"
        />
    </article>
{% endblock %}
