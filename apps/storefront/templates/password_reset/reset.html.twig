{% extends 'layout.html.twig' %}

{% block title %}Réinitialisation du mot de passe{% endblock %}

{% block body %}
    <h1>Réinitialisation du mot de passe</h1>

    <p>Saisissez le code reçu par email et votre nouveau mot de passe.</p>

    {{ form_start(form, {attr: {'data-testid': 'password-reset-form'}}) }}
        {{ form_widget(form) }}
        <button type="submit" data-testid="password-reset-submit">Réinitialiser</button>
    {{ form_end(form) }}

    <form method="post" action="{{ path('storefront_password_reset_resend', {identityId: identityId}) }}" data-testid="password-reset-resend-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset_resend') }}">
        <button type="submit" data-testid="password-reset-resend-submit">Renvoyer le code</button>
    </form>
{% endblock %}
