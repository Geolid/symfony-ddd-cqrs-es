{% extends 'layout.html.twig' %}

{% block importmap %}{{ importmap(['shared', 'auth']) }}{% endblock %}

{% block title %}{{ 'title'|trans({}, 'password_reset_request') }}{% endblock %}

{% block content %}
    <article>
        <h1>{{ 'title'|trans({}, 'password_reset_request') }}</h1>

        <p>{{ 'subtitle'|trans({}, 'password_reset_request') }}</p>

        {{ form_start(form) }}
            {{ form_row(form.email) }}
            <button type="submit">{{ 'button_submit'|trans({}, 'password_reset_request') }}</button>
        {{ form_end(form) }}
    </article>
{% endblock %}
