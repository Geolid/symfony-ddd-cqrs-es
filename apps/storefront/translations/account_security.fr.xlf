<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="fr" datatype="plaintext" original="account_security">
    <header>
      <tool tool-id="symfony" tool-name="Symfony"/>
    </header>
    <body>
      <trans-unit id="show_title">
        <source>show_title</source>
        <target>Connexion et Sécurité</target>
      </trans-unit>
      <trans-unit id="show_label_name">
        <source>show_label_name</source>
        <target>Nom</target>
      </trans-unit>
      <trans-unit id="show_label_email">
        <source>show_label_email</source>
        <target>E-mail</target>
      </trans-unit>
      <trans-unit id="show_label_password">
        <source>show_label_password</source>
        <target>Mot de passe</target>
      </trans-unit>
      <trans-unit id="show_label_two_factor">
        <source>show_label_two_factor</source>
        <target>Authentification à deux facteurs</target>
      </trans-unit>
      <trans-unit id="show_two_factor_description">
        <source>show_two_factor_description</source>
        <target>Configurez un authentificateur à deux facteurs pour ajouter une couche de sécurité supplémentaire à la connexion.</target>
      </trans-unit>
      <trans-unit id="show_button_configure_two_factor">
        <source>show_button_configure_two_factor</source>
        <target>Configurer</target>
      </trans-unit>
      <trans-unit id="show_backup_codes_generated_at">
        <source>show_backup_codes_generated_at</source>
        <target>Générés le %date%.</target>
      </trans-unit>
      <trans-unit id="show_backup_codes_remaining">
        <source>show_backup_codes_remaining</source>
        <target>%count% codes restants.</target>
      </trans-unit>
      <trans-unit id="enroll_totp_title">
        <source>enroll_totp_title</source>
        <target>Activer l'A2F</target>
      </trans-unit>
      <trans-unit id="enroll_totp_heading">
        <source>enroll_totp_heading</source>
        <target>Activer l'authentification à deux facteurs</target>
      </trans-unit>
      <trans-unit id="enroll_totp_step_indicator">
        <source>enroll_totp_step_indicator</source>
        <target>Étape 1 sur 2</target>
      </trans-unit>
      <trans-unit id="enroll_totp_backup_codes_step_indicator">
        <source>enroll_totp_backup_codes_step_indicator</source>
        <target>Étape 2 sur 2</target>
      </trans-unit>
      <trans-unit id="enroll_totp_note_label">
        <source>enroll_totp_note_label</source>
        <target>Remarque :</target>
      </trans-unit>
      <trans-unit id="enroll_totp_note">
        <source>enroll_totp_note</source>
        <target>Lors de toutes vos prochaines connexions après l'activation de l'authentification à deux facteurs, vous saisirez un code de sécurité généré à l'aide d'une application d'authentification.</target>
      </trans-unit>
      <trans-unit id="enroll_totp_step_open_verb">
        <source>enroll_totp_step_open_verb</source>
        <target>Ouvrez</target>
      </trans-unit>
      <trans-unit id="enroll_totp_step_open_rest">
        <source>enroll_totp_step_open_rest</source>
        <target>votre application d'authentification.</target>
      </trans-unit>
      <trans-unit id="enroll_totp_step_add_verb">
        <source>enroll_totp_step_add_verb</source>
        <target>Ajoutez</target>
      </trans-unit>
      <trans-unit id="enroll_totp_step_add_rest">
        <source>enroll_totp_step_add_rest</source>
        <target>un compte dans l'application et scannez le QR code ci-dessous :</target>
      </trans-unit>
      <trans-unit id="enroll_totp_instructions_manual_toggle">
        <source>enroll_totp_instructions_manual_toggle</source>
        <target>Vous ne pouvez pas scanner le QR code ?</target>
      </trans-unit>
      <trans-unit id="enroll_totp_manual_step1">
        <source>enroll_totp_manual_step1</source>
        <target>Ouvrez votre application d'authentification et choisissez « Ajouter un compte manuellement » dans le menu.</target>
      </trans-unit>
      <trans-unit id="enroll_totp_manual_step2">
        <source>enroll_totp_manual_step2</source>
        <target>Dans « Nom du compte », saisissez votre adresse e-mail complète.</target>
      </trans-unit>
      <trans-unit id="enroll_totp_manual_step3">
        <source>enroll_totp_manual_step3</source>
        <target>Dans « Clé », saisissez la clé suivante (les espaces ne sont pas nécessaires) :</target>
      </trans-unit>
      <trans-unit id="enroll_totp_manual_step4">
        <source>enroll_totp_manual_step4</source>
        <target>Réglez le type de clé sur « Basé sur le temps », puis appuyez sur Ajouter.</target>
      </trans-unit>
      <trans-unit id="enroll_totp_step_enter_verb">
        <source>enroll_totp_step_enter_verb</source>
        <target>Saisissez le code.</target>
      </trans-unit>
      <trans-unit id="enroll_totp_step_enter_rest">
        <source>enroll_totp_step_enter_rest</source>
        <target>Une fois le QR code scanné, saisissez le code généré par l'application :</target>
      </trans-unit>
      <trans-unit id="enroll_totp_button_submit">
        <source>enroll_totp_button_submit</source>
        <target>Vérifier le code et continuer</target>
      </trans-unit>
      <trans-unit id="enroll_totp_flash_invalid_code">
        <source>enroll_totp_flash_invalid_code</source>
        <target>Code invalide.</target>
      </trans-unit>
      <trans-unit id="enroll_totp_flash_enrolled">
        <source>enroll_totp_flash_enrolled</source>
        <target>Authentification à deux facteurs activée.</target>
      </trans-unit>
      <trans-unit id="enroll_totp_flash_enrolled_codes_kept">
        <source>enroll_totp_flash_enrolled_codes_kept</source>
        <target>Authentification à deux facteurs activée. Vos codes de secours existants restent valides.</target>
      </trans-unit>
      <trans-unit id="enroll_totp_backup_codes_title">
        <source>enroll_totp_backup_codes_title</source>
        <target>Enregistrez vos codes de secours</target>
      </trans-unit>
      <trans-unit id="enroll_totp_backup_codes_instructions">
        <source>enroll_totp_backup_codes_instructions</source>
        <target>Les codes de secours permettent d'accéder à votre compte si vous perdez votre appareil et ne pouvez pas recevoir de code d'authentification à deux facteurs.</target>
      </trans-unit>
      <trans-unit id="enroll_totp_backup_codes_warning">
        <source>enroll_totp_backup_codes_warning</source>
        <target>Pour la sécurité de votre compte, ne partagez jamais ces codes. Nous vous recommandons vivement de les enregistrer dans un gestionnaire de mots de passe sécurisé. Faites-le dès maintenant, ces codes ne seront affichés qu'une seule fois.</target>
      </trans-unit>
      <trans-unit id="backup_codes_button_copy">
        <source>backup_codes_button_copy</source>
        <target>Copier les codes</target>
      </trans-unit>
      <trans-unit id="backup_codes_button_download">
        <source>backup_codes_button_download</source>
        <target>Télécharger</target>
      </trans-unit>
      <trans-unit id="backup_codes_link_back">
        <source>backup_codes_link_back</source>
        <target>Retour aux paramètres A2F</target>
      </trans-unit>
      <trans-unit id="two_factor_settings_title">
        <source>two_factor_settings_title</source>
        <target>Paramètres d'authentification à deux facteurs (A2F)</target>
      </trans-unit>
      <trans-unit id="two_factor_settings_section_disable_title">
        <source>two_factor_settings_section_disable_title</source>
        <target>Désactiver l'authentification à deux facteurs</target>
      </trans-unit>
      <trans-unit id="two_factor_settings_section_disable_instructions">
        <source>two_factor_settings_section_disable_instructions</source>
        <target>Un code ne vous sera plus demandé à la connexion. Désactivez si vous devez configurer une nouvelle application d'authentification.</target>
      </trans-unit>
      <trans-unit id="two_factor_settings_section_disable_warning_label">
        <source>two_factor_settings_section_disable_warning_label</source>
        <target>Attention :</target>
      </trans-unit>
      <trans-unit id="two_factor_settings_section_disable_warning">
        <source>two_factor_settings_section_disable_warning</source>
        <target>Laisser ceci désactivé réduit la sécurité de votre compte.</target>
      </trans-unit>
      <trans-unit id="two_factor_settings_button_disable">
        <source>two_factor_settings_button_disable</source>
        <target>Désactiver l'A2F</target>
      </trans-unit>
      <trans-unit id="two_factor_settings_flash_unenrolled">
        <source>two_factor_settings_flash_unenrolled</source>
        <target>Authentification à deux facteurs désactivée.</target>
      </trans-unit>
      <trans-unit id="two_factor_settings_section_backup_codes_title">
        <source>two_factor_settings_section_backup_codes_title</source>
        <target>Codes de secours</target>
      </trans-unit>
      <trans-unit id="two_factor_settings_section_backup_codes_instructions">
        <source>two_factor_settings_section_backup_codes_instructions</source>
        <target>Utilisez les codes de secours pour vous connecter si vous perdez l'accès à votre appareil. Générer de nouveaux codes invalide définitivement les codes actuels.</target>
      </trans-unit>
      <trans-unit id="two_factor_settings_button_regenerate">
        <source>two_factor_settings_button_regenerate</source>
        <target>Générer de nouveaux codes de secours</target>
      </trans-unit>
      <trans-unit id="two_factor_settings_section_devices_instructions">
        <source>two_factor_settings_section_devices_instructions</source>
        <target>Déconnectez-vous de tous les appareils de confiance. Utilisez ceci si votre compte est compromis, ou si vous avez perdu un appareil connecté à ce compte. Un code de vérification vous sera demandé à la prochaine connexion.</target>
      </trans-unit>
      <trans-unit id="regenerate_backup_codes_title">
        <source>regenerate_backup_codes_title</source>
        <target>Vos nouveaux codes de secours</target>
      </trans-unit>
      <trans-unit id="regenerate_backup_codes_instructions">
        <source>regenerate_backup_codes_instructions</source>
        <target>Vos anciens codes de secours ne fonctionnent plus. Conservez ces nouveaux codes en lieu sûr. Ils ne seront plus jamais affichés.</target>
      </trans-unit>
      <trans-unit id="show_label_trusted_devices">
        <source>show_label_trusted_devices</source>
        <target>Appareils mémorisés</target>
      </trans-unit>
      <trans-unit id="show_button_revoke_device_trust">
        <source>show_button_revoke_device_trust</source>
        <target>Se déconnecter de tous les appareils</target>
      </trans-unit>
      <trans-unit id="revoke_device_trust_flash_success">
        <source>revoke_device_trust_flash_success</source>
        <target>Vous avez été déconnecté de tous les appareils mémorisés.</target>
      </trans-unit>
    </body>
  </file>
</xliff>
