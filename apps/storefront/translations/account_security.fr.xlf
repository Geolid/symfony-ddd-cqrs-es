<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="fr" datatype="plaintext" original="account_security">
    <header>
      <tool tool-id="symfony" tool-name="Symfony"/>
    </header>
    <body>
      <trans-unit id="show_title">
        <source>show_title</source>
        <target>Connexion et Sécurité</target>
      </trans-unit>
      <trans-unit id="show_label_name">
        <source>show_label_name</source>
        <target>Nom</target>
      </trans-unit>
      <trans-unit id="show_label_email">
        <source>show_label_email</source>
        <target>E-mail</target>
      </trans-unit>
      <trans-unit id="show_label_password">
        <source>show_label_password</source>
        <target>Mot de passe</target>
      </trans-unit>
      <trans-unit id="show_label_two_factor">
        <source>show_label_two_factor</source>
        <target>Vérification en deux étapes</target>
      </trans-unit>
      <trans-unit id="show_two_factor_description">
        <source>show_two_factor_description</source>
        <target>Configurez un authentificateur de vérification en deux étapes pour ajouter une couche de sécurité supplémentaire à la connexion.</target>
      </trans-unit>
      <trans-unit id="show_button_configure_two_factor">
        <source>show_button_configure_two_factor</source>
        <target>Configurer</target>
      </trans-unit>
      <trans-unit id="show_label_recovery_codes">
        <source>show_label_recovery_codes</source>
        <target>Codes de récupération</target>
      </trans-unit>
      <trans-unit id="show_recovery_codes_issued_at">
        <source>show_recovery_codes_issued_at</source>
        <target>Activés le %date%.</target>
      </trans-unit>
      <trans-unit id="show_recovery_codes_regenerated_at">
        <source>show_recovery_codes_regenerated_at</source>
        <target>Dernière régénération le %date%.</target>
      </trans-unit>
      <trans-unit id="show_recovery_codes_remaining">
        <source>show_recovery_codes_remaining</source>
        <target>%count% codes restants.</target>
      </trans-unit>
      <trans-unit id="issue_totp_title">
        <source>issue_totp_title</source>
        <target>Activer la V2E</target>
      </trans-unit>
      <trans-unit id="issue_totp_heading">
        <source>issue_totp_heading</source>
        <target>Inscrire un authentificateur pour la vérification en deux étapes</target>
      </trans-unit>
      <trans-unit id="issue_totp_step_indicator">
        <source>issue_totp_step_indicator</source>
        <target>Étape 1 sur 2</target>
      </trans-unit>
      <trans-unit id="issue_totp_note_label">
        <source>issue_totp_note_label</source>
        <target>Remarque :</target>
      </trans-unit>
      <trans-unit id="issue_totp_note">
        <source>issue_totp_note</source>
        <target>Lors de toutes vos prochaines connexions après l'activation de la vérification en deux étapes, vous saisirez un code de sécurité généré à l'aide d'une application d'authentification.</target>
      </trans-unit>
      <trans-unit id="issue_totp_step_open_verb">
        <source>issue_totp_step_open_verb</source>
        <target>Ouvrez</target>
      </trans-unit>
      <trans-unit id="issue_totp_step_open_rest">
        <source>issue_totp_step_open_rest</source>
        <target>votre application d'authentification.</target>
      </trans-unit>
      <trans-unit id="issue_totp_step_add_verb">
        <source>issue_totp_step_add_verb</source>
        <target>Ajoutez</target>
      </trans-unit>
      <trans-unit id="issue_totp_step_add_rest">
        <source>issue_totp_step_add_rest</source>
        <target>un compte dans l'application et scannez le QR code ci-dessous :</target>
      </trans-unit>
      <trans-unit id="issue_totp_instructions_manual_toggle">
        <source>issue_totp_instructions_manual_toggle</source>
        <target>Vous ne pouvez pas scanner le QR code ?</target>
      </trans-unit>
      <trans-unit id="issue_totp_manual_step1">
        <source>issue_totp_manual_step1</source>
        <target>Ouvrez votre application d'authentification et choisissez « Ajouter un compte manuellement » dans le menu.</target>
      </trans-unit>
      <trans-unit id="issue_totp_manual_step2">
        <source>issue_totp_manual_step2</source>
        <target>Dans « Nom du compte », saisissez votre adresse e-mail complète.</target>
      </trans-unit>
      <trans-unit id="issue_totp_manual_step3">
        <source>issue_totp_manual_step3</source>
        <target>Dans « Clé », saisissez la clé suivante (les espaces ne sont pas nécessaires) :</target>
      </trans-unit>
      <trans-unit id="issue_totp_manual_step4">
        <source>issue_totp_manual_step4</source>
        <target>Réglez le type de clé sur « Basé sur le temps », puis appuyez sur Ajouter.</target>
      </trans-unit>
      <trans-unit id="issue_totp_step_enter_verb">
        <source>issue_totp_step_enter_verb</source>
        <target>Saisissez le code.</target>
      </trans-unit>
      <trans-unit id="issue_totp_step_enter_rest">
        <source>issue_totp_step_enter_rest</source>
        <target>Une fois le QR code scanné, saisissez le code généré par l'application :</target>
      </trans-unit>
      <trans-unit id="issue_totp_button_submit">
        <source>issue_totp_button_submit</source>
        <target>Vérifier le code et continuer</target>
      </trans-unit>
      <trans-unit id="issue_totp_flash_invalid_code">
        <source>issue_totp_flash_invalid_code</source>
        <target>Code invalide.</target>
      </trans-unit>
      <trans-unit id="issue_totp_flash_issued">
        <source>issue_totp_flash_issued</source>
        <target>Vérification en deux étapes activée.</target>
      </trans-unit>
      <trans-unit id="issue_totp_flash_issued_codes_kept">
        <source>issue_totp_flash_issued_codes_kept</source>
        <target>Vérification en deux étapes activée. Vos codes de récupération existants restent valides.</target>
      </trans-unit>
      <trans-unit id="issue_totp_recovery_codes_title">
        <source>issue_totp_recovery_codes_title</source>
        <target>Enregistrez vos codes de récupération</target>
      </trans-unit>
      <trans-unit id="issue_totp_recovery_codes_instructions">
        <source>issue_totp_recovery_codes_instructions</source>
        <target>Les codes de récupération permettent d'accéder à votre compte si vous perdez votre appareil et ne pouvez pas recevoir de code de vérification en deux étapes.</target>
      </trans-unit>
      <trans-unit id="issue_totp_recovery_codes_warning">
        <source>issue_totp_recovery_codes_warning</source>
        <target>Pour la sécurité de votre compte, ne partagez jamais ces codes. Nous vous recommandons vivement de les enregistrer dans un gestionnaire de mots de passe sécurisé. Faites-le dès maintenant, ces codes ne seront affichés qu'une seule fois.</target>
      </trans-unit>
      <trans-unit id="recovery_codes_button_copy">
        <source>recovery_codes_button_copy</source>
        <target>Copier les codes</target>
      </trans-unit>
      <trans-unit id="recovery_codes_button_download">
        <source>recovery_codes_button_download</source>
        <target>Télécharger</target>
      </trans-unit>
      <trans-unit id="recovery_codes_link_back">
        <source>recovery_codes_link_back</source>
        <target>Retour aux paramètres V2E</target>
      </trans-unit>
      <trans-unit id="two_step_settings_title">
        <source>two_step_settings_title</source>
        <target>Paramètres de vérification en deux étapes (V2E)</target>
      </trans-unit>
      <trans-unit id="two_step_settings_section_disable_title">
        <source>two_step_settings_section_disable_title</source>
        <target>Désactiver la vérification en deux étapes</target>
      </trans-unit>
      <trans-unit id="two_step_settings_section_disable_instructions">
        <source>two_step_settings_section_disable_instructions</source>
        <target>Un code ne vous sera plus demandé à la connexion. Désactivez si vous devez configurer une nouvelle application d'authentification.</target>
      </trans-unit>
      <trans-unit id="two_step_settings_section_disable_warning_label">
        <source>two_step_settings_section_disable_warning_label</source>
        <target>Attention :</target>
      </trans-unit>
      <trans-unit id="two_step_settings_section_disable_warning">
        <source>two_step_settings_section_disable_warning</source>
        <target>Laisser ceci désactivé réduit la sécurité de votre compte.</target>
      </trans-unit>
      <trans-unit id="two_step_settings_button_disable">
        <source>two_step_settings_button_disable</source>
        <target>Désactiver la V2E</target>
      </trans-unit>
      <trans-unit id="two_step_settings_flash_revoked">
        <source>two_step_settings_flash_revoked</source>
        <target>Vérification en deux étapes désactivée.</target>
      </trans-unit>
      <trans-unit id="two_step_settings_section_recovery_codes_title">
        <source>two_step_settings_section_recovery_codes_title</source>
        <target>Codes de récupération</target>
      </trans-unit>
      <trans-unit id="two_step_settings_section_recovery_codes_instructions">
        <source>two_step_settings_section_recovery_codes_instructions</source>
        <target>Utilisez les codes de récupération pour vous connecter si vous perdez l'accès à votre appareil. Générer de nouveaux codes invalide définitivement les codes actuels.</target>
      </trans-unit>
      <trans-unit id="two_step_settings_button_regenerate">
        <source>two_step_settings_button_regenerate</source>
        <target>Générer de nouveaux codes de récupération</target>
      </trans-unit>
      <trans-unit id="two_step_settings_section_devices_instructions">
        <source>two_step_settings_section_devices_instructions</source>
        <target>Déconnectez-vous de tous les appareils de confiance. Utilisez ceci si votre compte est compromis, ou si vous avez perdu un appareil connecté à ce compte. Un code de vérification vous sera demandé à la prochaine connexion.</target>
      </trans-unit>
      <trans-unit id="regenerate_recovery_codes_title">
        <source>regenerate_recovery_codes_title</source>
        <target>Vos nouveaux codes de récupération</target>
      </trans-unit>
      <trans-unit id="regenerate_recovery_codes_instructions">
        <source>regenerate_recovery_codes_instructions</source>
        <target>Vos anciens codes de récupération ne fonctionnent plus. Conservez ces nouveaux codes en lieu sûr. Ils ne seront plus jamais affichés.</target>
      </trans-unit>
      <trans-unit id="show_label_trusted_devices">
        <source>show_label_trusted_devices</source>
        <target>Appareils mémorisés</target>
      </trans-unit>
      <trans-unit id="show_button_revoke_device_trust">
        <source>show_button_revoke_device_trust</source>
        <target>Se déconnecter de tous les appareils</target>
      </trans-unit>
      <trans-unit id="revoke_device_trust_flash_success">
        <source>revoke_device_trust_flash_success</source>
        <target>Vous avez été déconnecté de tous les appareils mémorisés.</target>
      </trans-unit>
    </body>
  </file>
</xliff>
