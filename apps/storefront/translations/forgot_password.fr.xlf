<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="fr" datatype="plaintext" original="forgot_password">
    <header>
      <tool tool-id="symfony" tool-name="Symfony"/>
    </header>
    <body>
      <trans-unit id="request_title">
        <source>request_title</source>
        <target>Aide avec le mot de passe</target>
      </trans-unit>
      <trans-unit id="request_subtitle">
        <source>request_subtitle</source>
        <target>Saisissez l'adresse e-mail associée à votre compte.</target>
      </trans-unit>
      <trans-unit id="request_label_email">
        <source>request_label_email</source>
        <target>Adresse e-mail</target>
      </trans-unit>
      <trans-unit id="request_button_submit">
        <source>request_button_submit</source>
        <target>Continuer</target>
      </trans-unit>
      <trans-unit id="request_error_not_found">
        <source>request_error_not_found</source>
        <target>Nous sommes désolés. Nous n'avons pas pu vous identifier avec les informations fournies.</target>
      </trans-unit>
      <trans-unit id="reset_title">
        <source>reset_title</source>
        <target>Réinitialisation du mot de passe</target>
      </trans-unit>
      <trans-unit id="reset_subtitle">
        <source>reset_subtitle</source>
        <target>Saisissez le code envoyé à %email% et votre nouveau mot de passe.</target>
      </trans-unit>
      <trans-unit id="reset_label_new_password">
        <source>reset_label_new_password</source>
        <target>Nouveau mot de passe (au moins %min% caractères)</target>
      </trans-unit>
      <trans-unit id="reset_help_new_password">
        <source>reset_help_new_password</source>
        <target>Les mots de passe doivent au moins avoir %min% caractères.</target>
      </trans-unit>
      <trans-unit id="reset_label_new_password_confirm">
        <source>reset_label_new_password_confirm</source>
        <target>Confirmez le nouveau mot de passe</target>
      </trans-unit>
      <trans-unit id="reset_button_submit">
        <source>reset_button_submit</source>
        <target>Réinitialiser</target>
      </trans-unit>
      <trans-unit id="reset_error_same_password">
        <source>reset_error_same_password</source>
        <target>Il doit être différent de votre mot de passe actuel.</target>
      </trans-unit>
      <trans-unit id="reset_flash_reset">
        <source>reset_flash_reset</source>
        <target>Mot de passe réinitialisé, vous pouvez vous connecter.</target>
      </trans-unit>
      <trans-unit id="reset_flash_not_authenticatable">
        <source>reset_flash_not_authenticatable</source>
        <target>Ce compte n'est pas accessible pour le moment.</target>
      </trans-unit>
    </body>
  </file>
</xliff>
