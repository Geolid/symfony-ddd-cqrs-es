<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="en" datatype="plaintext" original="account_security">
    <header>
      <tool tool-id="symfony" tool-name="Symfony"/>
    </header>
    <body>
      <trans-unit id="show_title">
        <source>show_title</source>
        <target>Login &amp; Security</target>
      </trans-unit>
      <trans-unit id="show_label_name">
        <source>show_label_name</source>
        <target>Name</target>
      </trans-unit>
      <trans-unit id="show_label_email">
        <source>show_label_email</source>
        <target>Email</target>
      </trans-unit>
      <trans-unit id="show_label_password">
        <source>show_label_password</source>
        <target>Password</target>
      </trans-unit>
      <trans-unit id="show_label_two_factor">
        <source>show_label_two_factor</source>
        <target>Two-step verification</target>
      </trans-unit>
      <trans-unit id="show_status_enabled">
        <source>show_status_enabled</source>
        <target>Two-factor authentication enabled.</target>
      </trans-unit>
      <trans-unit id="show_link_enable_two_factor">
        <source>show_link_enable_two_factor</source>
        <target>Enable</target>
      </trans-unit>
      <trans-unit id="issue_totp_title">
        <source>issue_totp_title</source>
        <target>Enable two-factor authentication</target>
      </trans-unit>
      <trans-unit id="issue_totp_instructions_qr">
        <source>issue_totp_instructions_qr</source>
        <target>Scan this QR code with your authenticator app (Google Authenticator, etc.):</target>
      </trans-unit>
      <trans-unit id="issue_totp_instructions_manual">
        <source>issue_totp_instructions_manual</source>
        <target>Or enter this key manually:</target>
      </trans-unit>
      <trans-unit id="issue_totp_instructions_confirm">
        <source>issue_totp_instructions_confirm</source>
        <target>Then enter the displayed code to confirm:</target>
      </trans-unit>
      <trans-unit id="issue_totp_button_submit">
        <source>issue_totp_button_submit</source>
        <target>Confirm</target>
      </trans-unit>
      <trans-unit id="issue_totp_flash_invalid_code">
        <source>issue_totp_flash_invalid_code</source>
        <target>Invalid code, try again.</target>
      </trans-unit>
      <trans-unit id="issue_totp_flash_issued">
        <source>issue_totp_flash_issued</source>
        <target>Two-factor authentication enabled.</target>
      </trans-unit>
      <trans-unit id="issue_totp_backup_codes_title">
        <source>issue_totp_backup_codes_title</source>
        <target>Your backup codes</target>
      </trans-unit>
      <trans-unit id="issue_totp_backup_codes_instructions">
        <source>issue_totp_backup_codes_instructions</source>
        <target>Store these codes somewhere safe. Each one can only be used once to sign in if you lose access to your authenticator app. They will never be shown again.</target>
      </trans-unit>
      <trans-unit id="issue_totp_backup_codes_button_continue">
        <source>issue_totp_backup_codes_button_continue</source>
        <target>I've saved my codes</target>
      </trans-unit>
      <trans-unit id="show_label_trusted_devices">
        <source>show_label_trusted_devices</source>
        <target>Remembered devices</target>
      </trans-unit>
      <trans-unit id="show_button_revoke_device_trust">
        <source>show_button_revoke_device_trust</source>
        <target>Sign out of all devices</target>
      </trans-unit>
      <trans-unit id="revoke_device_trust_flash_success">
        <source>revoke_device_trust_flash_success</source>
        <target>You've been signed out of all remembered devices. You'll be asked for a code again next time you sign in from them.</target>
      </trans-unit>
    </body>
  </file>
