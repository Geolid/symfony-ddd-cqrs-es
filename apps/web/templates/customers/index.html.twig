{% extends 'layout.html.twig' %}
{% import '@ui/_macros.html.twig' as ui %}

{% block title %}{{ 'customers.index.title'|trans }}{% endblock %}
{% block heading %}{{ 'customers.index.title'|trans }}{% endblock %}

{% block content %}
    <table>
        <thead>
        <tr>
            <th>{{ 'customers.index.table.id'|trans }}</th>
            <th>{{ 'customers.index.table.email'|trans }}</th>
            <th>{{ 'customers.index.table.registered_at'|trans }}</th>
            <th>{{ 'customers.index.table.erased_at'|trans }}</th>
            <th>{{ 'customers.index.table.actions'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for customer in customers.items %}
            <tr>
                <td>{{ customer.id }}</td>
                <td data-testid="customer-email">{{ customer.email ?? '—' }}</td>
                <td>{{ customer.registeredAt|date('Y-m-d H:i') }}</td>
                <td>{{ customer.erasedAt ? customer.erasedAt|date('Y-m-d H:i') : '—' }}</td>
                <td>
                    {% if customer.erasedAt is null %}
                        {{ ui.confirm_modal(
                            'erase-customer-' ~ customer.id,
                            '/customers/' ~ customer.id ~ '/erase',
                            'customers.index.erase_button'|trans,
                            'customers.index.erase_confirm_message'|trans,
                            {cancel_label: 'customers.index.erase_dismiss_button'|trans},
                        ) }}
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr data-testid="customers-empty"><td colspan="5">{{ 'customers.index.empty'|trans }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
    {{ ui.pagination(customers.pagination, 'customers_index', {}) }}
{% endblock %}
