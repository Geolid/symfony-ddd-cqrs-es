{% extends 'layout.html.twig' %}

{% block title %}{{ 'security.login.title'|trans }}{% endblock %}

{% block heading %}{% endblock %}

{% block content %}
    <div class="form-page">
        <hgroup>
            <h1>{{ 'security.login.title'|trans }}</h1>
        </hgroup>

        {% if error %}
            <twig:ui:Alert variant="error" data-testid="login-error">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </twig:ui:Alert>
        {% endif %}

        <article>
            <form method="post" data-testid="login-form">
                <label for="login">{{ 'security.login.label_login'|trans }}</label>
                <input type="text" id="login" name="login" value="{{ last_username }}" required autofocus>

                <label for="password">{{ 'security.login.label_password'|trans }}</label>
                <input type="password" id="password" name="password" required>

                <label for="remember_me">
                    <input type="checkbox" id="remember_me" name="_remember_me" data-testid="login-remember-me">
                    {{ 'security.login.label_remember_me'|trans }}
                </label>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" data-testid="login-submit">
                    {{ 'security.login.button_submit'|trans }}
                </button>
            </form>
        </article>
    </div>
{% endblock %}
