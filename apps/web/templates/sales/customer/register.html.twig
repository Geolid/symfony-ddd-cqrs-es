{% extends 'layout.html.twig' %}

{% block title %}{{ 'sales.customer.register.title'|trans }}{% endblock %}

{% block heading %}{% endblock %}

{% block content %}
    <div class="form-page">
        <hgroup>
            <h1>{{ 'sales.customer.register.title'|trans }}</h1>
        </hgroup>

        <article>
            {{ form_start(form, {attr: {'data-testid': 'register-customer-form'}}) }}

            {{ form_row(form.email) }}
            {{ form_row(form.password) }}

            <button type="submit">
                {{ 'sales.customer.register.button_submit'|trans }}
            </button>

            {{ form_end(form) }}
        </article>
    </div>
{% endblock %}
