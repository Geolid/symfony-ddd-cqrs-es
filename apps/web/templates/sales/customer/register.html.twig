{% extends 'layout.html.twig' %}

{% block title %}{{ 'sales.customer.register.title'|trans }}{% endblock %}
{% block heading %}{{ 'sales.customer.register.title'|trans }}{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <p>
        {{ form_label(form.email) }}<br>
        {{ form_widget(form.email) }}
        {{ form_errors(form.email) }}
    </p>
    <p>
        {{ form_label(form.password) }}<br>
        {{ form_widget(form.password) }}
        {{ form_errors(form.password) }}
    </p>
    <button type="submit">{{ 'sales.customer.register.submit_button'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
