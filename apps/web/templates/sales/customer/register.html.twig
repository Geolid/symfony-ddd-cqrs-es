{% extends 'layout.html.twig' %}

{% block title %}{{ 'sales.customer.register.title'|trans }}{% endblock %}
{% block heading %}{{ 'sales.customer.register.title'|trans }}{% endblock %}

{% block content %}
    {{ form_start(form) }}
    {{ form_label(form.email) }}
    {{ form_widget(form.email) }}
    {{ form_errors(form.email) }}

    {{ form_label(form.password) }}
    {{ form_widget(form.password) }}
    {{ form_errors(form.password) }}

    <button type="submit">{{ 'sales.customer.register.button_submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
