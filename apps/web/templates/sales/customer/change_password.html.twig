{% extends 'layout.html.twig' %}

{% block title %}{{ 'sales.customer.change_password.title'|trans }}{% endblock %}
{% block heading %}{{ 'sales.customer.change_password.title'|trans }}{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <p>
        {{ form_label(form.password) }}<br>
        {{ form_widget(form.password) }}
        {{ form_errors(form.password) }}
    </p>
    <button type="submit">{{ 'sales.customer.change_password.submit_button'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
