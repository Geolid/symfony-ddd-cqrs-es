{% extends 'layout.html.twig' %}

{% block title %}{{ 'sales.order.show.title'|trans }}{% endblock %}
{% block heading %}{{ 'sales.order.show.title'|trans }}{% endblock %}

{% block content %}
    <table>
        <tbody>
        <tr>
            <th>{{ 'sales.order.list.table.id'|trans }}</th>
            <td data-testid="order-id">{{ order.orderId }}</td>
        </tr>
        <tr>
            <th>{{ 'sales.order.list.table.total'|trans }}</th>
            <td data-testid="order-total">{{ order.totalAmountInCents|amount }}</td>
        </tr>
        <tr>
            <th>{{ 'sales.order.list.table.status'|trans }}</th>
            <td><span class="status" data-testid="order-status">{{ ('sales.order.status_view.badge.' ~ order.status.value)|trans }}</span></td>
        </tr>
        <tr>
            <th>{{ 'sales.order.list.table.placed_at'|trans }}</th>
            <td>{{ order.placedAt|date('Y-m-d H:i') }}</td>
        </tr>
        </tbody>
    </table>

    {% set workflowSteps = order_workflow_steps(order.status.value) %}
    {% if workflowSteps is not empty %}
        {% set labeledSteps = [] %}
        {% for step in workflowSteps %}
            {% set labeledSteps = labeledSteps|merge([{
                label: ('sales.order.status_view.step.' ~ step.key)|trans,
                state: step.state,
            }]) %}
        {% endfor %}
        <twig:ui:StepIndicator :steps="labeledSteps" data-testid="order-workflow" />
    {% endif %}

    <h2>{{ 'sales.order.show.title_lines'|trans }}</h2>
    <table data-testid="order-lines">
        <thead>
        <tr>
            <th>{{ 'sales.order.show.table_lines.product'|trans }}</th>
            <th>{{ 'sales.order.show.table_lines.quantity'|trans }}</th>
            <th>{{ 'sales.order.show.table_lines.unit_price'|trans }}</th>
            <th>{{ 'sales.order.show.table_lines.subtotal'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for line in lines %}
            <tr data-testid="order-line">
                <td>{{ line.label }}</td>
                <td>{{ line.quantity }}</td>
                <td>{{ line.unitAmountInCents|amount }}</td>
                <td>{{ (line.quantity * line.unitAmountInCents)|amount }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h2>{{ 'sales.order.show.title_payment'|trans }}</h2>
    {% if order.paymentStatus is null %}
        <p data-testid="order-payment">{{ 'sales.order.show.payment_none'|trans }}</p>
    {% else %}
        <p data-testid="order-payment">
            <span class="status">{{ ('sales.order.status_view.badge.' ~ order.status.value)|trans }}</span>
        </p>
        {% if order.status.value == 'payment_pending' %}
            <twig:ui:Alert variant="info" data-testid="order-payment-hint">
                <span data-testid="order-payment-reference">{{ 'sales.order.show.payment_reference'|trans({'%reference%': order.paymentReference}) }}</span>
                — <a href="/webhook/docs">{{ 'sales.order.show.hint_payment'|trans }}</a>
            </twig:ui:Alert>
        {% endif %}
    {% endif %}

    <h2>{{ 'sales.order.show.title_shipment'|trans }}</h2>
    {% if order.shipmentStatus is null %}
        <p data-testid="order-shipment">{{ 'sales.order.show.shipment_none'|trans }}</p>
    {% else %}
        <p data-testid="order-shipment">
            <span class="status">{{ ('sales.order.status_view.badge.' ~ order.status.value)|trans }}</span>
            {% if order.trackingReference %}
                <br>
                <small data-testid="order-shipment-tracking-reference">{{ 'sales.order.show.shipment_tracking_reference'|trans({'%reference%': order.trackingReference}) }}</small>
            {% endif %}
        </p>
        {% if order.status.value == 'preparing' %}
            <twig:ui:Alert variant="info" data-testid="order-shipment-hint">
                {{ 'sales.order.show.hint_shipment'|trans }} <code>fulfilment:shipment:dispatch-pending</code>
            </twig:ui:Alert>
        {% endif %}
    {% endif %}

    <h2>{{ 'sales.order.list.table.actions'|trans }}</h2>
    {% if order.status.isPlaced %}
        <div role="group">
            <twig:ui:ConfirmModal
                id="cancel-order-{{ order.orderId }}"
                :actionUrl="path('sales_order_cancel', {id: order.orderId})"
                :triggerLabel="'sales.order.list.button_cancel'|trans"
                :message="'sales.order.list.message_cancel_confirm'|trans"
                :cancelLabel="'sales.order.list.button_cancel_dismiss'|trans"
            />
            <twig:ui:CsrfButton
                :actionUrl="path('sales_order_pay', {id: order.orderId})"
                csrfId="pay-order-{{ order.orderId }}"
                :label="'sales.order.list.button_pay'|trans"
                data-testid="pay-order-button"
            />
        </div>
    {% elseif order.status.isCancelled %}
        <p>{{ 'sales.order.show.no_actions_cancelled'|trans }}</p>
    {% else %}
        <p>{{ 'sales.order.show.no_actions'|trans }}</p>
    {% endif %}

    <p><a href="{{ path('sales_order_list') }}">{{ 'sales.order.show.link_back'|trans }}</a></p>
{% endblock %}
