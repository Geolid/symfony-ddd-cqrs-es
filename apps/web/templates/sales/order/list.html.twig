{% extends 'layout.html.twig' %}

{% block title %}{{ 'sales.order.list.title'|trans }}{% endblock %}

{% block heading %}
    {{ 'sales.order.list.title'|trans }}
    <a href="{{ path('sales_order_place') }}" role="button" data-testid="place-order-button"
       style="float: right">{{ 'sales.order.list.button_place_order'|trans }}</a>
{% endblock %}

{% block content %}
    <table>
        <thead>
        <tr>
            <th>{{ 'sales.order.list.table.id'|trans }}</th>
            <th>{{ 'sales.order.list.table.total'|trans }}</th>
            <th>{{ 'sales.order.list.table.status'|trans }}</th>
            <th>{{ 'sales.order.list.table.placed_at'|trans }}</th>
            <th>{{ 'sales.order.list.table.actions'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for order in orders.items %}
            {% set cancellable = order.status.isPlaced %}
            <tr>
                <td>{{ order.orderId }}</td>
                <td data-testid="order-total">{{ order.totalAmountInCents|amount }}</td>
                <td data-testid="order-status">
                    <span class="status">{{ ('sales.order.status_view.badge.' ~ order.status.value)|trans }}</span>
                </td>
                <td>{{ order.placedAt|date('Y-m-d H:i') }}</td>
                <td>
                    <div role="group">
                        <a href="{{ path('sales_order_show', {id: order.orderId}) }}" role="button"
                           class="outline">{{ 'sales.order.list.button_view'|trans }}</a>
                        <twig:ui:ConfirmModal
                            id="cancel-order-{{ order.orderId }}"
                            :actionUrl="path('sales_order_cancel', {id: order.orderId})"
                            :triggerLabel="'sales.order.list.button_cancel'|trans"
                            :message="'sales.order.list.message_cancel_confirm'|trans"
                            :cancelLabel="'sales.order.list.button_cancel_dismiss'|trans"
                            :disabled="not cancellable"
                        />
                        <twig:ui:CsrfButton
                            :actionUrl="path('sales_order_pay', {id: order.orderId})"
                            csrfId="pay-order-{{ order.orderId }}"
                            :label="'sales.order.list.button_pay'|trans"
                            :disabled="not cancellable"
                            data-testid="pay-order-button"
                        />
                    </div>
                </td>
            </tr>
        {% else %}
            <tr data-testid="orders-empty"><td colspan="5">{{ 'sales.order.list.empty'|trans }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
    <twig:ui:Pagination :currentPage="orders.pagination.currentPage" :lastPage="orders.pagination.lastPage" route="sales_order_list" />
{% endblock %}
