{% extends 'layout.html.twig' %}
{% import '@ui/_macros.html.twig' as ui %}

{% block title %}{{ 'sales.order.list.title'|trans }}{% endblock %}
{% block heading %}{{ 'sales.order.list.title'|trans }}{% endblock %}

{% block content %}
    <table>
        <thead>
        <tr>
            <th>{{ 'sales.order.list.table.id'|trans }}</th>
            <th>{{ 'sales.order.list.table.total'|trans }}</th>
            <th>{{ 'sales.order.list.table.status'|trans }}</th>
            <th>{{ 'sales.order.list.table.payment'|trans }}</th>
            <th>{{ 'sales.order.list.table.placed_at'|trans }}</th>
            <th>{{ 'sales.order.list.table.actions'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for order in orders.items %}
            {% set payment = payments[order.id] %}
            <tr>
                <td>{{ order.id }}</td>
                <td data-testid="order-total">{{ order.totalAmountInCents|amount }}</td>
                <td><span class="status">{{ ('sales.order.status.' ~ order.status)|trans }}</span></td>
                <td data-testid="order-payment">
                    {% if payment is null %}
                        —
                    {% elseif payment.status == capturedPaymentStatus %}
                        <span class="status">{{ ('sales.order.payment_status.' ~ payment.status)|trans }}</span>
                    {% else %}
                        <span class="status">{{ ('sales.order.payment_status.' ~ payment.status)|trans }}</span>
                        <br>
                        <small data-testid="order-payment-reference">{{ 'sales.order.list.payment_reference'|trans({'%reference%': payment.reference}) }}</small>
                        <br>
                        <small>{{ 'sales.order.list.payment_hint'|trans }}</small>
                    {% endif %}
                </td>
                <td>{{ order.placedAt|date('Y-m-d H:i') }}</td>
                <td>
                    {% if order.status == cancellableStatus %}
                        {{ ui.confirm_modal(
                            'cancel-order-' ~ order.id,
                            path('sales_order_cancel', {id: order.id}),
                            'sales.order.list.cancel_button'|trans,
                            'sales.order.list.cancel_confirm_message'|trans,
                            {cancel_label: 'sales.order.list.cancel_dismiss_button'|trans},
                        ) }}
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr data-testid="orders-empty"><td colspan="6">{{ 'sales.order.list.empty'|trans }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
    {{ ui.pagination(orders.pagination, 'sales_order_list', {}) }}

    <h2>{{ 'sales.order.list.my_account_title'|trans }}</h2>
    {{ ui.confirm_modal(
        'erase-customer-' ~ customerId,
        path('sales_customer_erase'),
        'sales.order.list.erase_button'|trans,
        'sales.order.list.erase_confirm_message'|trans,
        {cancel_label: 'sales.order.list.erase_dismiss_button'|trans, button_class: 'outline contrast'},
    ) }}
{% endblock %}
