{% extends 'layout.html.twig' %}
{% import '@ui/_macros.html.twig' as ui %}

{% block title %}{{ 'orders.index.title'|trans }}{% endblock %}
{% block heading %}{{ 'orders.index.title'|trans }}{% endblock %}

{% block content %}
    <table>
        <thead>
        <tr>
            <th>{{ 'orders.index.table.id'|trans }}</th>
            <th>{{ 'orders.index.table.customer'|trans }}</th>
            <th>{{ 'orders.index.table.total'|trans }}</th>
            <th>{{ 'orders.index.table.status'|trans }}</th>
            <th>{{ 'orders.index.table.placed_at'|trans }}</th>
            <th>{{ 'orders.index.table.actions'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for order in orders.items %}
            <tr>
                <td>{{ order.id }}</td>
                <td>{{ order.customerId }}</td>
                <td>{{ (order.totalAmountInCents / 100)|number_format(2) }}</td>
                <td><span class="status">{{ ('orders.status.' ~ order.status)|trans }}</span></td>
                <td>{{ order.placedAt|date('Y-m-d H:i') }}</td>
                <td>
                    {% if order.status == 'placed' %}
                        {{ ui.confirm_modal(
                            'cancel-order-' ~ order.id,
                            '/orders/' ~ order.id ~ '/cancel',
                            'orders.index.cancel_button'|trans,
                            'orders.index.cancel_confirm_message'|trans,
                            {cancel_label: 'orders.index.cancel_dismiss_button'|trans}
                        ) }}
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6">{{ 'orders.index.empty'|trans }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
    {{ ui.pagination(orders.pagination, 'orders_index', {}) }}
{% endblock %}
