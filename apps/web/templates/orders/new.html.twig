{% extends 'layout.html.twig' %}

{% block title %}{{ 'orders.new.title'|trans }}{% endblock %}
{% block heading %}{{ 'orders.new.title'|trans }}{% endblock %}

{% block content %}
    <form method="post" action="/orders">
        <p>
            <label>{{ 'orders.new.customer_label'|trans }}<br>
                <input type="text" name="customerId" required>
            </label>
        </p>
        <p>
            <label>{{ 'orders.new.amount_label'|trans }}<br>
                <input type="number" name="totalAmountInCents" min="0" required>
            </label>
        </p>
        <button type="submit">{{ 'orders.new.submit_button'|trans }}</button>
    </form>
{% endblock %}
