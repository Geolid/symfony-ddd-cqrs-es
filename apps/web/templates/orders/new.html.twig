{% extends 'layout.html.twig' %}

{% block title %}{{ 'orders.new.title'|trans }}{% endblock %}
{% block heading %}{{ 'orders.new.title'|trans }}{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <p>
        {{ form_label(form.customerId) }}<br>
        {{ form_widget(form.customerId) }}
        {{ form_errors(form.customerId) }}
    </p>
    <p>
        {{ form_label(form.totalAmountInCents) }}<br>
        {{ form_widget(form.totalAmountInCents) }}
        {{ form_errors(form.totalAmountInCents) }}
    </p>
    <button type="submit">{{ 'orders.new.submit_button'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
