{% extends 'layout.html.twig' %}

{% block title %}Place an order{% endblock %}
{% block heading %}Place an order{% endblock %}

{% block body %}
    <form method="post" action="/orders">
        <p>
            <label>Customer ID<br>
                <input type="text" name="customerId" required>
            </label>
        </p>
        <p>
            <label>Total amount (cents)<br>
                <input type="number" name="totalAmountInCents" min="0" required>
            </label>
        </p>
        <button type="submit">Place order</button>
    </form>
{% endblock %}
