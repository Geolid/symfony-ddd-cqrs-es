{% extends 'layout.html.twig' %}
{% import '@ui/_macros.html.twig' as ui %}

{% block title %}{{ 'fulfilment.shipment.list.title'|trans }}{% endblock %}
{% block heading %}{{ 'fulfilment.shipment.list.title'|trans }}{% endblock %}

{% block content %}
    <table>
        <thead>
        <tr>
            <th>{{ 'fulfilment.shipment.list.table.id'|trans }}</th>
            <th>{{ 'fulfilment.shipment.list.table.order'|trans }}</th>
            <th>{{ 'fulfilment.shipment.list.table.customer'|trans }}</th>
            <th>{{ 'fulfilment.shipment.list.table.total'|trans }}</th>
            <th>{{ 'fulfilment.shipment.list.table.status'|trans }}</th>
            <th>{{ 'fulfilment.shipment.list.table.created_at'|trans }}</th>
            <th>{{ 'fulfilment.shipment.list.table.dispatched_at'|trans }}</th>
            <th>{{ 'fulfilment.shipment.list.table.delivered_at'|trans }}</th>
            <th>{{ 'fulfilment.shipment.list.table.order_cancelled_at'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for shipment in shipments.items %}
            <tr>
                <td>{{ shipment.id }}</td>
                <td>{{ shipment.orderId }}</td>
                <td>{{ shipment.customerId ?? '—' }}</td>
                <td>{{ shipment.orderTotalInCents is not null ? (shipment.orderTotalInCents / 100)|number_format(2) : '—' }}</td>
                <td><span class="status">{{ ('fulfilment.shipment.status.' ~ shipment.status)|trans }}</span></td>
                <td>{{ shipment.createdAt|date('Y-m-d H:i') }}</td>
                <td>{{ shipment.dispatchedAt ? shipment.dispatchedAt|date('Y-m-d H:i') : '—' }}</td>
                <td>{{ shipment.deliveredAt ? shipment.deliveredAt|date('Y-m-d H:i') : '—' }}</td>
                <td>{{ shipment.orderCancelledAt ? shipment.orderCancelledAt|date('Y-m-d H:i') : '—' }}</td>
            </tr>
        {% else %}
            <tr data-testid="shipments-empty"><td colspan="9">{{ 'fulfilment.shipment.list.empty'|trans }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
    {{ ui.pagination(shipments.pagination, 'fulfilment_shipment_list', {}) }}
{% endblock %}
