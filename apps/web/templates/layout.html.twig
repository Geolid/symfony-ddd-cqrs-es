{% extends '@ui/base.html.twig' %}
{% import '@ui/_macros.html.twig' as ui %}

{% block title %}{{ 'layout.title'|trans }}{% endblock %}

{% block javascripts %}
    {% block importmap %}{{ importmap(['shared']) }}{% endblock %}
{% endblock %}

{% block body %}
    <header class="container">
        <nav>
            <ul><li><strong>{{ 'layout.title'|trans }}</strong></li></ul>
            <ul>
                <li><a href="/orders">{{ 'layout.nav.orders'|trans }}</a></li>
                <li><a href="/shipments">{{ 'layout.nav.shipments'|trans }}</a></li>
                <li><a href="/orders/new" role="button">{{ 'layout.nav.new_order'|trans }}</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        {{ ui.flashes(app.flashes) }}
        <h1>{% block heading %}{% endblock %}</h1>
        {% block content %}{% endblock %}
    </main>
{% endblock %}
