{% extends '@ui/base.html.twig' %}

{% block title %}{{ 'layout.title'|trans }}{% endblock %}

{% block javascripts %}
    {% block importmap %}{{ importmap(['shared', 'web']) }}{% endblock %}
{% endblock %}

{% block body %}
    <header class="container">
        <nav>
            <ul><li><strong>{{ 'layout.title'|trans }}</strong></li></ul>
            {% set route = app.request.attributes.get('_route') %}
            {% set route_params = app.request.attributes.get('_route_params')|default({}) %}
            <ul>
                <li>
                    <a href="{{ path(route, route_params|merge({_locale: 'en'})) }}" data-testid="nav-locale-en"{{ app.request.locale == 'en' ? ' aria-current="true"' }}>EN</a>
                    /
                    <a href="{{ path(route, route_params|merge({_locale: 'fr'})) }}" data-testid="nav-locale-fr"{{ app.request.locale == 'fr' ? ' aria-current="true"' }}>FR</a>
                </li>
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <li>
                        <details class="dropdown">
                            <summary data-testid="nav-account" class="icon-row"><twig:ux:icon name="account" class="icon" /> {{ 'layout.nav.account'|trans }}</summary>
                            <ul>
                                <li><a href="{{ path('sales_order_list') }}">{{ 'layout.nav.orders'|trans }}</a></li>
                                <li><a href="{{ path('sales_customer_profile') }}" data-testid="nav-profile">{{ 'layout.nav.profile'|trans }}</a></li>
                                <li><a href="{{ logout_path() }}" data-testid="nav-logout">{{ 'layout.nav.logout'|trans }}</a></li>
                            </ul>
                        </details>
                    </li>
                {% else %}
                    <li><a href="{{ path('sales_customer_register') }}">{{ 'layout.nav.register_customer'|trans }}</a></li>
                    <li><a href="{{ path('security_login') }}" data-testid="nav-login">{{ 'layout.nav.login'|trans }}</a></li>
                {% endif %}
            </ul>
        </nav>
    </header>

    <main class="container">
        <twig:ui:Flashes :flashes="app.flashes" />
        {% block heading %}{% endblock %}
        {% block content %}{% endblock %}
    </main>
{% endblock %}
