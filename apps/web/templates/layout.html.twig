<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Ordering & Shipping{% endblock %}</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 960px; margin: 2rem auto; color: #1a1a1a; }
        nav a { margin-right: 1rem; }
        table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
        th, td { border: 1px solid #ddd; padding: 0.5rem 0.75rem; text-align: left; }
        th { background: #f5f5f5; }
        form.inline { display: inline; }
        .status { padding: 0.15rem 0.5rem; border-radius: 0.25rem; font-size: 0.85rem; background: #eee; }
    </style>
</head>
<body>
<nav>
    <a href="/orders">Orders</a>
    <a href="/shipments">Shipments</a>
    <a href="/orders/new">Place an order</a>
</nav>
<h1>{% block heading %}{% endblock %}</h1>
{% block body %}{% endblock %}
</body>
</html>
