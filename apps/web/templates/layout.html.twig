{% extends '@ui/base.html.twig' %}
{% import '@ui/_macros.html.twig' as ui %}

{% block title %}{{ 'layout.title'|trans }}{% endblock %}

{% block javascripts %}
    {% block importmap %}{{ importmap(['shared']) }}{% endblock %}
{% endblock %}

{% block body %}
    <nav>
        <a href="/orders">{{ 'layout.nav.orders'|trans }}</a>
        <a href="/shipments">{{ 'layout.nav.shipments'|trans }}</a>
        <a href="/orders/new">{{ 'layout.nav.new_order'|trans }}</a>
    </nav>
    {{ ui.flashes(app.flashes) }}
    <h1>{% block heading %}{% endblock %}</h1>
    {% block content %}{% endblock %}
{% endblock %}
