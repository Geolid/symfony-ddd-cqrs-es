includes:
    - ../phpstan.base.neon

parameters:
    # One tmpDir per DM — a shared resultCache.php would be discarded on every config switch.
    tmpDir: '%currentWorkingDirectory%/var/phpstan/%env.APP_ID%'

    paths:
        - '%currentWorkingDirectory%/apps/%env.APP_ID%/config/'
        - '%currentWorkingDirectory%/apps/%env.APP_ID%/src/'
        - '%currentWorkingDirectory%/apps/%env.APP_ID%/tests/'
        # PHPat rule files must be analysed too — otherwise editing one doesn't invalidate the result cache.
        - '%currentWorkingDirectory%/tools/PHPat/'

    symfony:
        containerXmlPath: %currentWorkingDirectory%/var/cache/%env.APP_ENV%/%env.APP_ID%/Bootstrap_Kernel%env.APP_ENV_UCFIRST%DebugContainer.xml
