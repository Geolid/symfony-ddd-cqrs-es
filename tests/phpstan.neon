includes:
    - ../phpstan.base.neon

parameters:
    tmpDir: '%currentWorkingDirectory%/var/phpstan/tests'

    paths:
        - '%currentWorkingDirectory%/tests/'
        - '%currentWorkingDirectory%/tools/PHPUnit/'

    symfony:
        containerXmlPath: %currentWorkingDirectory%/var/cache/%env.APP_ENV%/Bootstrap_Kernel%env.APP_ENV_UCFIRST%DebugContainer.xml

    ignoreErrors:
        -
            # CredentialFakerProvider methods are registered on the generator at runtime (FoundryFaker).
            message: '#^Call to an undefined method Faker\\Generator::(apiKeySecret|totpSecret|backupCodes)\(\)\.$#'
            identifier: method.notFound
        -
            # Same KernelTestCaseHelper indirection as above, reached from EventSourcingTrait::store().
            message: '#^Service "Patchlevel\\EventSourcing\\Repository\\RepositoryManager" is private\.$#'
            identifier: symfonyContainer.privateService
            paths:
                - '**/EventSourcingTrait.php'
